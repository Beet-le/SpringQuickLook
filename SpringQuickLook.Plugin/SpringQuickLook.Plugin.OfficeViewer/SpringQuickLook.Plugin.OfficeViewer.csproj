    <Target Name="TrimTransitiveOutput" AfterTargets="Build">
        <!-- The PDFViewer project reference leaks transitive project outputs and content (ImageViewer,
             HtmlViewer, Magick.NET, PdfiumViewer...) into this plugin folder. Keep the folder limited
             to this plugin and its Syncfusion dependencies; those assemblies are shipped by their own plugins. -->
        <ItemGroup>
            <_TransitiveJunk Include="$(OutputPath)SpringQuickLook.Plugin.PDFViewer.*" />
            <_TransitiveJunk Include="$(OutputPath)SpringQuickLook.Plugin.ImageViewer.*" />
            <_TransitiveJunk Include="$(OutputPath)SpringQuickLook.Plugin.HtmlViewer.*" />
            <_TransitiveJunk Include="$(OutputPath)Magick.Native-*.dll" />
            <_TransitiveJunk Include="$(OutputPath)exiv2-ql-*.dll" />
            <_TransitiveJunk Include="$(OutputPath)PdfiumViewer.dll" />
            <_TransitiveJunk Include="$(OutputPath)System.IO.Compression.dll" />
            <_TransitiveJunk Include="$(OutputPath)UnblockZoneIdentifier.dll" />
            <_TransitiveJunk Include="$(OutputPath)Translations.config" />
        </ItemGroup>
        <Delete Files="@(_TransitiveJunk)" />
    </Target>

